 };
 
diff --git a/Telegram/SourceFiles/history/history_item.cpp b/Telegram/SourceFiles/history/history_item.cpp
index 2b3c4d5..6e7f8a9 100644
--- a/Telegram/SourceFiles/history/history_item.cpp
+++ b/Telegram/SourceFiles/history/history_item.cpp
@@ -450,6 +450,21 @@ void HistoryItem::applyEdition(HistoryMessageEdition &&edition) {
+	// Clean Anti-Edit: Сохраняем предыдущую редакцию сообщения в памяти
+	recordEditHistory(originalText());
+
 	setOriginalText(edition.textWithEntities);
 	// ...
 }
 
+void HistoryItem::markDeletedLocally() {
+	_isDeletedLocally = true;
+	// Добавляем префикс в локальный буфер текста
+	auto current = originalText();
+	current.text = QString::fromUtf8("[Удалено] ") + current.text;
+	setOriginalText(current);
+}
+
+void HistoryItem::recordEditHistory(const TextWithEntities &previousText) {
+	_editHistory.push_back(previousText);
+}
+
+const std::vector<TextWithEntities> &HistoryItem::editHistory() const {
+	return _editHistory;
+}
+
