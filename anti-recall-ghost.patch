@@ -142,6 +142,14 @@ public:
 	[[nodiscard]] bool isPost() const;
 	[[nodiscard]] bool isSilent() const;
 
+	// Clean Anti-Recall & Anti-Edit Hooks
+	[[nodiscard]] bool isDeletedLocally() const {
+		return _isDeletedLocally;
+	}
+	void markDeletedLocally();
+	void recordEditHistory(const TextWithEntities &previousText);
+	[[nodiscard]] const std::vector<TextWithEntities> &editHistory() const;
+
 	[[nodiscard]] virtual bool hasViews() const;
 	[[nodiscard]] virtual int viewsCount() const;
 
@@ -285,6 +293,9 @@ private:
 	MsgId _id = 0;
 	PeerData *_from = nullptr;
