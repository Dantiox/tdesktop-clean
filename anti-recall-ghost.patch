diff --git a/Telegram/SourceFiles/data/data_session.cpp b/Telegram/SourceFiles/data/data_session.cpp
index 4d5e6f7..8a9b0c1 100644
--- a/Telegram/SourceFiles/data/data_session.cpp
+++ b/Telegram/SourceFiles/data/data_session.cpp
@@ -890,6 +890,14 @@ void Session::deleteMessages(
 	for (const auto id : ids) {
 		if (const auto item = message(peer, id)) {
+			// Clean Anti-Recall: Перехват события удаления от сервера
+			// Не уничтожаем объект из памяти HistoryItem, а помечаем и перерисовываем
+			if (Core::App().settings().antiRecall()) {
+				item->markDeletedLocally();
+				notifyItemRepaint(item);
+				continue; // Пропускаем деструктор item! Сообщение сохраняется
+			}
+
 			destroyMessage(item);
 		}
 	}
 }
 
